{
  "name": "newbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p signer-service/tsconfig.json --noEmit",
    "typecheck:worker": "tsc --noEmit",
    "typecheck:signer": "tsc -p signer-service/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "node scripts/deploy.mjs deploy",
    "build": "node scripts/deploy.mjs build",
    "smoke": "node scripts/smoke.mjs",
    "tg:commands": "node scripts/set-telegram-commands.mjs",
    "d1:apply": "node scripts/apply-sql.mjs newbot-db migrations/0001_init.sql",
    "d1:apply:0002": "node scripts/apply-sql.mjs newbot-db migrations/0002_privy_custodial.sql",
    "gen:privy-key": "node scripts/gen-privy-auth-key.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.58.0",
    "@polymarket/builder-relayer-client": "^0.0.10",
    "@polymarket/builder-signing-sdk": "^1.0.0",
    "@polymarket/clob-client": "^5.8.1",
    "@polymarket/clob-client-v2": "^1.0.6",
    "@privy-io/node": "^0.23.0",
    "viem": "^2.53.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260320.0",
    "@types/node": "^25.6.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.80.0"
  },
  "overrides": {
    "axios": "^1.12.2"
  }
}
